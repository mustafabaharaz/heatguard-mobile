{
  "expo": {
    "name": "HeatGuard",
    "slug": "heatguard",
    "scheme": "heatguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#162A47"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tarnaka.heatguard",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HeatGuard uses your location to show heat conditions and the forecast where you are, find the nearest cooling centers, and add your location to emergency texts you choose to send."
        }
      ],
      "./plugins/withFmtCxx17"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6425d0d0-4a5e-44a0-934e-3def8cd716a8"
      }
    }
  }
}
